---
import Layout from "../components/Layout.astro";
import { getCollection } from "astro:content";
import me from "../assets/avatar.webp";
import Prose from "../components/Prose.astro";
import Listening from "../components/Listening.astro";
import FavouriteAlbums from "../components/FavouriteAlbums.astro";
import MediaRow from "../components/MediaRow.astro";
import PostList from "../components/PostList.astro";

const books = (await getCollection("books")).sort((a, b) =>
  a.data.title.localeCompare(b.data.title, "en"),
);

const primaryLinks = [
  ["twitter/x", "https://x.com/pzrsaa"],
  ["linkedin", "https://www.linkedin.com/in/parsamesgarha"],
  ["github", "https://github.com/pzrsa"],
  ["youtube", "https://www.youtube.com/@pzrsa"],
];

const moreLinks = [
  ["substack", "https://parsam.substack.com"],
  ["letterboxd", "https://letterboxd.com/pzrsa/"],
  ["instagram", "https://www.instagram.com/parsamesgarha"],
  ["last.fm", "https://www.last.fm/user/pzrsa"],
  ["spotify", "https://open.spotify.com/user/e4ebkdi70a4wu03jwbwrglzhk"],
  ["source code", "https://github.com/pzrsa/parsam.io"],
  ["monkeytype", "https://monkeytype.com/profile/pzrsa"],
];
---

<Layout image={new URL("home.png", Astro.url)}>
  <main>
    <h1 class="sr-only">Parsa Mesgarha</h1>

    <a
      href="https://x.com/pzrsaa"
      target="_blank"
      rel="noopener noreferrer"
      class="float-right mb-2 ml-5 size-20"
    >
      <img
        alt="Parsa Mesgarha on twitter/x"
        src={me.src}
        width={80}
        height={80}
        loading="eager"
        decoding="async"
        class="size-20"
      />
    </a>
    <Prose class="prose-p:first:mt-0">
      <p>
        I’m a Senior Machine Learning Engineer at{" "}
        <a href="https://www.yaak.ai/" target="_blank">
          Yaak
        </a>
        , where I lead all robotics work, from hardware and data collection to
        training models and deploying them on robots.
      </p>
      <p>
        Before that I was at{" "}
        <span class="prose-a:text-tesla-red! dark:prose-a:text-red-500!">
          <a href="https://www.tesla.com/" target="_blank">
            Tesla
          </a>
        </span>
        , writing software for Gigafactory expansion, and I started my career at{" "}
        <span class="prose-a:decoration-google-blue prose-a:hover:text-blue-800">
          <a href="https://google.com/" target="_blank">
            <span class="text-google-blue">G</span>
            <span class="text-google-red">o</span>
            <span class="text-google-yellow">o</span>
            <span class="text-google-blue">g</span>
            <span class="text-google-green">l</span>
            <span class="text-google-red">e</span>
          </a>
        </span>{" "}
        at 18 in London, working on{" "}
        <a href="https://www.chromium.org/Home/" target="_blank">
          Chrome
        </a>
        ,{" "}
        <a href="https://source.android.com/" target="_blank">
          Android
        </a>{" "}
        and{" "}
        <a href="https://web.dev/" target="_blank">
          the web platform
        </a>
        .
      </p>
      <p>
        Born in England to Persian parents, grew up in London, now living in
        Berlin.
      </p>
      <p>
        I <a href="/blog">write</a> about robot learning, ML and engineering,
        and sometimes life. Say <a href="mailto:hi@parsam.io">hi</a>. I love
        meeting new people.
      </p>
    </Prose>
    <nav aria-label="Social links" class="mt-3 text-sm">
      {primaryLinks.map(([label, href]) => (
        <a
          href={href}
          target="_blank"
          class="mr-px inline-block py-2 text-link hover:text-link-hover focus-visible:text-link-hover min-[360px]:mr-1 sm:mr-4"
        >
          {label}
        </a>
      ))}
      <details id="more-links" class="inline">
        <summary class="list-inside cursor-pointer whitespace-nowrap py-2 text-muted hover:text-foreground [display:inline_list-item]">
          more
        </summary>
        <ul class="mt-2 flex flex-wrap gap-x-4 gap-y-1 whitespace-normal">
          {moreLinks.map(([label, href]) => (
            <li>
              <a
                href={href}
                target="_blank"
                class="inline-block py-1 text-link hover:text-link-hover focus-visible:text-link-hover"
              >
                {label}
              </a>
            </li>
          ))}
        </ul>
      </details>
    </nav>

    <section
      aria-labelledby="writing-title"
      class="mt-8 border-t-2 border-foreground pt-4"
    >
      <h2 id="writing-title" class="mb-4 text-xl font-bold">
        recent
      </h2>
      <PostList count={5} />
      <p class="mt-4 font-bold">
        <a href="/blog">view all →</a>
      </p>
    </section>

    <section
      aria-labelledby="listening-title"
      class="mt-8 min-w-0 border-t-2 border-foreground pt-4"
    >
      <h2 id="listening-title" class="mb-4 text-base font-semibold">
        listening
      </h2>
      <Listening server:defer>
        <p slot="fallback" class="text-xs text-muted">
          loading listening history…
        </p>
      </Listening>
    </section>

    <div class="mt-8 grid gap-9 sm:grid-cols-2 sm:gap-8">
      <section aria-labelledby="books-title" class="min-w-0">
        <h2 id="books-title" class="mb-4 text-base font-semibold">
          favourite books
        </h2>
        <ul class="space-y-3 text-sm leading-relaxed">
          {books.map(({ id, data: book }) => (
            <li>
              <MediaRow
                href={
                  book.notesSlug
                    ? "/" + book.notesSlug
                    : "https://books.google.com/books?id=" + id
                }
                title={book.title}
                subtitle={book.author}
                image={`https://books.google.com/books/content?id=${id}&printsec=frontcover&img=1&zoom=1`}
                imageHeight={60}
                external={!book.notesSlug}
              />
            </li>
          ))}
        </ul>
      </section>
      <FavouriteAlbums />
    </div>
  </main>
</Layout>
