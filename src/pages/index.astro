---
import Layout from "../components/Layout.astro";
import me from "../assets/avatar.webp";
import Prose from "../components/Prose.astro";
import NowPlaying from "../components/NowPlaying.astro";
import RecentlyPlayed from "../components/RecentlyPlayed.astro";
import NewsletterForm from "../components/NewsletterForm.astro";
import PostList from "../components/PostList.astro";
import { getCollection } from "astro:content";

const [albums, books] = await Promise.all([
  getCollection("albums"),
  getCollection("books"),
]);

const linksClass = "w-fit font-bold";
const gridClass = "grid grid-cols-3 sm:grid-cols-4 gap-x-3 gap-y-5 not-prose";
const thumbClass = "h-24 w-auto mb-2 block";
---

<Layout image={new URL("home.png", Astro.url)}>
  <h1 class="sr-only">Parsa Mesgarha</h1>

  <script>
    const toggle = document.getElementById("recently-played-toggle");
    const content = document.getElementById("recently-played-content");
    const arrow = document.getElementById("recently-played-arrow");

    toggle?.addEventListener("click", () => {
      const isExpanded = toggle.getAttribute("aria-expanded") === "true";
      toggle.setAttribute("aria-expanded", String(!isExpanded));
      content?.classList.toggle("hidden");
      if (arrow) {
        arrow.style.transform = isExpanded ? "rotate(0deg)" : "rotate(90deg)";
      }
    });
  </script>
  <a href="https://x.com/pzrsaa" target="_blank" class="float-right ml-4 mb-2">
    <img
      alt="Parsa Mesgarha"
      src={me.src}
      loading="eager"
      decoding="async"
      class="size-20 sm:size-28"
    />
  </a>
  <Prose>
    <p>
      I work at
      <a href="https://www.yaak.ai/" target="_blank"> Yaak AI </a> as a Senior Machine
      Learning Engineer, where I run everything robotics, like infra, models and
      hardware. Previously I was at {" "}
      <span class="prose-a:text-tesla-red! dark:prose-a:text-red-500!"
        ><a href="https://www.tesla.com" target="_blank">Tesla</a>
      </span>, writing software that scaled Gigafactories, and at {" "}
      <span class="prose-a:decoration-google-blue prose-a:hover:text-blue-800"
        ><a href="https://google.com" target="_blank">
          <span class="text-google-blue">G</span><span class="text-google-red"
            >o</span
          ><span class="text-google-yellow">o</span><span
            class="text-google-blue">g</span
          ><span class="text-google-green">l</span><span class="text-google-red"
            >e
          </span>
        </a></span
      > in London, working on {" "}
      <a href="https://www.chromium.org/Home/" target="_blank">Chrome</a>, {" "}
      <a href="https://source.android.com/" target="_blank">Android</a>, and {
        " "
      }
      <a href="https://web.dev/" target="_blank">the web platform</a>.
    </p>

    <p>
      I'm 23, born in England to Persian parents, grew up in London, and now
      live in Berlin.
    </p>
    <p>
      I <a href="/blog">write</a> about stuff I find interesting enough to share,
      mostly on things in technology. You can <a href="/newsletter">subscribe</a
      > to get notified about new posts.
    </p>
    <p>
      Say <a href="mailto:hi@parsam.io" target="_blank">hi</a>. I love meeting
      new people.
    </p>
    <div class="not-prose clear-right mb-4">
      <NowPlaying server:defer />
      <button
        id="recently-played-toggle"
        class="flex items-center gap-2 font-bold mt-4 hover:opacity-80"
        aria-expanded="false"
      >
        <span id="recently-played-arrow" class="transition-transform">▶</span>
        <span>Recently Played</span>
      </button>
      <div id="recently-played-content" class="hidden mt-2">
        <RecentlyPlayed server:defer />
      </div>
    </div>
    <div>
      <div>
        <h3 class="border-t-2 border-foreground pt-4">Recently</h3>
        <PostList count={5} />
        <h4><a href="/blog">See all posts →</a></h4>
      </div>
      <h3 class="border-t-2 border-foreground pt-4">Newsletter</h3>
      <NewsletterForm server:defer />
      <h3 class="border-t-2 border-foreground pt-4">Links</h3>
      <div class="not-prose gap-1 grid grid-cols-3 sm:grid-cols-4">
        <a class={linksClass} href="https://x.com/pzrsaa" target="_blank"
          >Twitter/X</a
        >
        <a class={linksClass} href="https://github.com/pzrsa" target="_blank"
          >GitHub</a
        >
        <a
          class={linksClass}
          href="https://www.linkedin.com/in/parsamesgarha"
          target="_blank"
        >
          LinkedIn
        </a>
        <a
          class={linksClass}
          href="https://www.youtube.com/@pzrsa"
          target="_blank">YouTube</a
        >
        <a
          class={linksClass}
          href="https://parsam.substack.com"
          target="_blank"
        >
          Substack
        </a>
        <a
          class={linksClass}
          href="https://letterboxd.com/pzrsa/"
          target="_blank"
        >
          Letterboxd
        </a>
        <a
          class={linksClass}
          href="https://www.instagram.com/parsamesgarha"
          target="_blank"
        >
          Instagram
        </a>
        <a
          class={linksClass}
          href="https://www.last.fm/user/pzrsa"
          target="_blank">Last.fm</a
        >
        <a
          class={linksClass}
          href="https://open.spotify.com/user/e4ebkdi70a4wu03jwbwrglzhk"
          target="_blank"
        >
          Spotify
        </a>
        <a
          class={linksClass}
          href="https://github.com/pzrsa/parsam.io"
          target="_blank"
        >
          Source Code
        </a>
        <a
          class={linksClass}
          href="https://monkeytype.com/profile/pzrsa"
          target="_blank"
        >
          Monkeytype
        </a>
      </div>
    </div>
    <div>
      <h2 class="border-t-2 border-foreground pt-4">Favourites</h2>
      <h3>Books</h3>
      <div class={gridClass}>
        {
          books.map((book) => (
            <div>
              <a
                class="block"
                href={
                  book.data.notesSlug
                    ? `/${book.data.notesSlug}`
                    : `https://books.google.com/books?id=${book.id}`
                }
                target={book.data.notesSlug ? undefined : "_blank"}
              >
                <img
                  src={`https://books.google.com/books/content?id=${book.id}&printsec=frontcover&img=1&zoom=1`}
                  alt={book.data.title}
                  width={85}
                  height={128}
                  loading="lazy"
                  class={thumbClass}
                />
              </a>
              <a
                class="font-bold block text-sm"
                href={
                  book.data.notesSlug
                    ? `/${book.data.notesSlug}`
                    : `https://books.google.com/books?id=${book.id}`
                }
                target={book.data.notesSlug ? undefined : "_blank"}
              >
                {book.data.title}
              </a>
              <div class="text-xs opacity-60">
                {book.data.author} · {book.data.year}
              </div>
            </div>
          ))
        }
      </div>
      <h3>Music</h3>
      <div class={gridClass}>
        {
          albums.map((album) => (
            <div>
              <a
                class="block"
                href={`https://open.spotify.com/album/${album.id}`}
                target="_blank"
              >
                <img
                  src={`https://i.scdn.co/image/${album.data.imageID}`}
                  alt={album.data.title}
                  width={128}
                  height={128}
                  loading="lazy"
                  class={thumbClass}
                />
              </a>
              <a
                class="font-bold block text-sm"
                href={`https://open.spotify.com/album/${album.id}`}
                target="_blank"
              >
                {album.data.title}
              </a>
              <div class="text-xs opacity-60">
                {album.data.artist} · {album.data.year}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </Prose>
</Layout>
