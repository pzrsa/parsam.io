---
interface Props {
  class?: string;
}
---

<div
  class={"prose leading-relaxed prose-p:my-4 prose-a:no-underline prose-a:hover:underline prose-a:font-medium prose-a:decoration-2 prose-a:text-blue-600 prose-a:hover:text-blue-800 dark:prose-a:text-blue-400 dark:prose-a:hover:text-blue-300" +
    " " +
    (Astro.props.class || "")}
>
  <slot />
</div>
