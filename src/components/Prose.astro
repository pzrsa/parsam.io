---
interface Props {
  class?: string;
}
---

<div
  class={
    "prose leading-relaxed prose-p:my-4 prose-a:font-medium prose-a:text-link prose-a:underline prose-a:decoration-current/40 prose-a:decoration-1 prose-a:underline-offset-[0.15em] prose-a:hover:text-link-hover prose-a:hover:decoration-current prose-a:focus-visible:text-link-hover prose-a:focus-visible:decoration-current" +
    " " +
    (Astro.props.class || "")
  }
>
  <slot />
</div>
