---
import type { MarkdownHeading } from "astro";

interface Props {
  title: string;
  headings: MarkdownHeading[];
}

const { title, headings } = Astro.props;
const top = Math.min(...headings.map((heading) => heading.depth));
const entries = headings.filter((heading) => heading.depth <= top + 1);
---

{entries.length >= 3 && (
  <details class="not-prose inline text-sm">
    <summary class="list-inside cursor-pointer whitespace-nowrap text-muted hover:text-foreground [display:inline_list-item]">
      contents
    </summary>
    <ul class="mt-3 space-y-2 leading-relaxed">
      <li>
        <a href="#top">{title}</a>
      </li>
      {entries.map((heading) => (
        <li class={heading.depth === top ? "" : "pl-4"}>
          <a href={"#" + heading.slug}>{heading.text}</a>
        </li>
      ))}
    </ul>
  </details>
)}
