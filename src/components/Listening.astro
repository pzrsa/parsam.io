---
import NowPlaying from "./NowPlaying.astro";
import RecentlyPlayed from "./RecentlyPlayed.astro";
import { getCollection } from "astro:content";

const albums = await getCollection("albums");
---

<NowPlaying />
<div class="mt-4">
  <h3 class="mb-3 text-xs font-normal text-muted">recently played</h3>
  <RecentlyPlayed />
</div>

<details class="mt-4 text-sm">
  <summary class="w-fit cursor-pointer text-muted hover:text-foreground">
    favourite albums
  </summary>
  <ul class="mt-3 grid grid-cols-3 gap-x-3 gap-y-4">
    {albums.map((album) => (
      <li class="min-w-0">
        <a
          href={`https://open.spotify.com/album/${album.id}`}
          target="_blank"
          class="group block hover:no-underline"
        >
          <img
            src={`https://i.scdn.co/image/${album.data.imageID}`}
            alt=""
            width={96}
            height={96}
            loading="lazy"
            decoding="async"
            class="aspect-square w-full object-cover"
          />
          <span
            title={album.data.title}
            class="content-link mt-1 block truncate text-xs group-hover:text-link"
          >
            {album.data.title}
          </span>
          <span
            title={album.data.artist}
            class="block truncate text-xs font-normal text-muted"
          >
            {album.data.artist}
          </span>
        </a>
      </li>
    ))}
  </ul>
</details>
