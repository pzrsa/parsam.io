---
interface NowPlaying {
  isPlaying: boolean;
  title?: string;
  artist?: string;
  album?: string;
  albumImageUrl?: string;
  songUrl?: string;
  explicit?: boolean;
}

let data: NowPlaying | null = null;
let error = false;

try {
  const res = await fetch(new URL("/api/now-playing", Astro.url));
  if (!res.ok) throw new Error("bad status");
  data = await res.json<NowPlaying>();
} catch {
  error = true;
}
---

{!error && data?.isPlaying ? (
  <div class="flex min-w-0 max-w-full items-start gap-3 text-sm leading-relaxed">
    <a href={data.songUrl} target="_blank" class="shrink-0">
      <img
        alt={data.title}
        src={data.albumImageUrl}
        width="48"
        height="48"
        loading="eager"
        decoding="async"
        class="size-12 object-cover"
      />
    </a>
    <div class="min-w-0 flex-1">
      <p class="text-xs text-muted">now playing</p>
      <a
        href={data.songUrl}
        target="_blank"
        title={data.title}
        class="content-link block w-fit max-w-full truncate"
      >
        {data.title}
      </a>
      <p title={data.artist} class="truncate text-xs text-muted">
        {data.artist}
      </p>
    </div>
  </div>
) : (
  <p class="text-xs">
    <a
      href="https://open.spotify.com/user/e4ebkdi70a4wu03jwbwrglzhk"
      target="_blank"
      rel="noopener noreferrer"
      class="content-link"
    >
      {error ? "listening status unavailable" : "not playing right now"}
    </a>
  </p>
)}
