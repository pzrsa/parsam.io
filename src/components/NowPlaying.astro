---
import MediaRow from "./MediaRow.astro";

interface NowPlaying {
  isPlaying: boolean;
  title?: string;
  artist?: string;
  album?: string;
  albumImageUrl?: string;
  songUrl?: string;
  explicit?: boolean;
}

let data: NowPlaying | null = null;
let error = false;

try {
  const res = await fetch(new URL("/api/now-playing", Astro.url));
  if (!res.ok) throw new Error("bad status");
  data = await res.json<NowPlaying>();
} catch {
  error = true;
}
---

{!error && data?.isPlaying ? (
  <div class="min-w-0">
    <p class="mb-3 text-xs text-muted">now playing</p>
    <MediaRow
      href={
        data.songUrl ??
        "https://open.spotify.com/user/e4ebkdi70a4wu03jwbwrglzhk"
      }
      title={data.title ?? ""}
      subtitle={data.artist ?? ""}
      image={data.albumImageUrl}
      eager
    />
  </div>
) : (
  <p class="text-xs">
    <a
      href="https://open.spotify.com/user/e4ebkdi70a4wu03jwbwrglzhk"
      target="_blank"
      rel="noopener noreferrer"
    >
      {error ? "listening status unavailable" : "not playing right now"}
    </a>
  </p>
)}
