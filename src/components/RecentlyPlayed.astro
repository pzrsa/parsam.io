---
import MediaRow from "./MediaRow.astro";

interface Track {
  title: string;
  artist: string;
  album: string;
  albumImageUrl?: string;
  songUrl: string;
  explicit: boolean;
  playedAt: string;
}

let data: { tracks: Track[] } | null = null;
let error = false;

try {
  const res = await fetch(new URL("/api/recently-played", Astro.url));
  if (!res.ok) throw new Error("bad status");
  data = await res.json<{ tracks: Track[] }>();
} catch {
  error = true;
}
---

{!error && !data && <p>loading...</p>}

{error || !data?.tracks?.length ? (
  <p>No recently played tracks</p>
) : (
  <ul class="min-w-0 max-w-full space-y-3 text-sm leading-relaxed">
    {data.tracks.map((track) => (
      <li class="min-w-0">
        <MediaRow
          href={track.songUrl}
          title={track.title}
          subtitle={track.artist}
          image={track.albumImageUrl}
        />
      </li>
    ))}
  </ul>
)}
