---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { getBlogPosts, getPostExcerpt } from "../data/utils";

interface Props {
  count?: number;
  showDates?: boolean;
}

const { count, showDates = false } = Astro.props;

const posts = await getBlogPosts();
const latestPosts = count ? posts.slice(0, count) : posts;

const allImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/blog/**/*.{webp,jpg,jpeg,png,gif}",
);
const covers = await Promise.all(
  latestPosts.map(async (post) => {
    if (!post.data.cover) return undefined;
    const loader = allImages[`/src/assets/blog/${post.data.cover}`];
    return loader ? (await loader()).default : undefined;
  }),
);
---

<ul class:list={["flex flex-col not-prose", showDates ? "gap-2" : "gap-4"]}>
  {latestPosts.map((post, i) => {
    const cover = covers[i];
    const year = post.data.date.getFullYear();
    const firstForYear =
      !latestPosts[i - 1] ||
      latestPosts[i - 1].data.date.getFullYear() !== year;
    const lastForYear =
      !latestPosts[i + 1] ||
      latestPosts[i + 1].data.date.getFullYear() !== year;

    return (
      <li>
        {showDates && firstForYear && (
          <span class="mb-3 flex justify-end text-sm font-bold">{year}</span>
        )}
        <div class:list={["post-row", showDates && lastForYear && "mb-4"]}>
          {showDates && (
            <time
              datetime={post.data.date.toISOString().slice(0, 10)}
              class="mb-1.5 block text-right text-sm text-muted"
            >
              {post.data.date.toLocaleDateString("en-GB", {
                day: "numeric",
                month: "short",
              })}
            </time>
          )}
          <a
            href={`/${post.id}`}
            class="post-body group/entry flex items-start gap-4 text-foreground no-underline max-[480px]:gap-3"
          >
            <span class="min-w-0 flex-1 wrap-anywhere">
              <span class="post-link text-lg font-bold decoration-1 underline-offset-[0.15em] group-hover/entry:text-link-hover group-hover/entry:underline group-focus-visible/entry:text-link-hover group-focus-visible/entry:underline">
                {post.data.title}
              </span>
              {post.data.author && (
                <span class="text-sm"> ({post.data.author})</span>
              )}
              <span class="mt-1.5 line-clamp-2 text-sm leading-normal font-normal text-muted">
                {getPostExcerpt(post)}
              </span>
            </span>
            {cover && (
              <span class="post-cover block aspect-3/2 w-24 flex-none bg-foreground/3 max-[480px]:w-18">
                <Image
                  src={cover}
                  alt=""
                  width={240}
                  height={160}
                  fit="cover"
                  class="block h-full w-full object-cover shadow-none transform-none"
                />
              </span>
            )}
          </a>
        </div>
      </li>
    );
  })}
</ul>
