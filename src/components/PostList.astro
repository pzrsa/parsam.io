---
import { getBlogPosts, getPostExcerpt } from "../data/utils";

interface Props {
  count?: number;
  groupByYear?: boolean;
}

const { count, groupByYear = false } = Astro.props;
const posts = await getBlogPosts();
const latestPosts = count ? posts.slice(0, count) : posts;
---

<ul class="not-prose flex flex-col gap-5">
  {latestPosts.map((post, i) => {
    const year = post.data.date.getFullYear();
    const excerpt = getPostExcerpt(post);
    const firstForYear =
      !latestPosts[i - 1] ||
      latestPosts[i - 1].data.date.getFullYear() !== year;

    return (
      <li>
        {groupByYear && firstForYear && (
          <h2
            class:list={[
              "mb-3 text-sm font-normal text-muted",
              i > 0 && "mt-6",
            ]}
          >
            {year}
          </h2>
        )}
        <div class="flex items-baseline justify-between gap-4">
          <a href={"/" + post.id} class="content-link min-w-0 leading-relaxed">
            {post.data.title}
            {post.data.author && <span> ({post.data.author})</span>}
          </a>
          <time
            datetime={post.data.date.toISOString().slice(0, 10)}
            class="shrink-0 text-xs text-muted"
          >
            {post.data.date.toLocaleDateString("en-GB", {
              day: "numeric",
              month: "short",
              ...(!groupByYear && { year: "numeric" }),
            })}
          </time>
        </div>
        {excerpt && (
          <p class="mt-1 text-sm leading-relaxed text-muted">{excerpt}</p>
        )}
      </li>
    );
  })}
</ul>
