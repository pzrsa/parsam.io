---
import "../styles/global.css";
import Nav from "./Nav.astro";
import { Font } from "astro:assets";

interface Props {
  title?: string;
  image?: URL;
  description?: string;
  post?: boolean;
  date?: Date;
}

const baseTitle = "Parsa Mesgarha";
const defaultDescription =
  "Senior Machine Learning Engineer at Yaak AI, working on getting robots to understand and interact with the world around them";

const { title, image, post, date } = Astro.props;
const description = Astro.props.description || defaultDescription;

const fullTitle = title ? `${title} - ${baseTitle}` : baseTitle;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/apple-icon.png"
      type="image/png"
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={baseTitle}
      href={new URL("rss.xml", Astro.site)}
    />

    <link rel="canonical" href={Astro.url} />
    <meta name="robots" content="index, follow" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />

    <meta property="og:title" content={title ?? "Parsa Mesgarha"} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={post ? "article" : "website"} />
    {
      post && date && (
        <meta
          property="article:published_time"
          content={date.toISOString()}
        />
      )
    }
    <meta property="og:url" content={Astro.url} />
    <meta property="og:image" content={image} />

    <meta name="twitter:title" content={title ?? "Parsa Mesgarha"} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@pzrsaa" />
    <meta name="twitter:image" content={image} />
    <Font cssVariable="--font-literata" preload />
  </head>
  <body class="max-w-2xl mx-auto py-8 px-6">
    <Nav />
    <slot />
  </body>
</html>
