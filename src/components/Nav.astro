---
interface Props {
  title?: string;
}
const { title } = Astro.props;
const base = "font-bold text-blue-600 hover:text-blue-800";
---

<nav class="font-mono flex pb-2 mb-6 flex-col border-b">
  <span class="flex gap-x-10">
    <span class="font-bold text-lg">Navigation</span>
    <span class="font-bold"
      >~/<a href="/" class={base}>home</a>/<a href="/blog" class={base}
        >blog</a
      >{title ? <span>/{title}</span> : ""}</span
    >
  </span>
</nav>
