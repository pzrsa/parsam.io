---
import name from "../assets/name.svg";
---

<nav class="flex justify-between items-center gap-4 py-2 mb-6 border-b-2 border-black">
  <a href="/" class="shrink-0 py-1">
    <img
      alt="Parsa Mesgarha"
      src={name.src}
      loading="eager"
      decoding="async"
      class="h-4.5 sm:h-5 border-none shadow-none hover:translate-none hover:opacity-80"
    />
  </a>
  <a href="/blog" class="py-1">blog</a>
</nav>
