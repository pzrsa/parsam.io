---
import name from "../assets/name.svg";

const mask = `url(${name.src}) no-repeat left center / contain`;
---

<nav
  class="mb-6 flex items-center justify-between gap-4 border-b-2 border-foreground py-2"
>
  <a href="/" class="shrink-0 hover:opacity-80">
    <span
      role="img"
      aria-label="Parsa Mesgarha"
      class="block bg-foreground h-4.5 sm:h-5 aspect-1601/155"
      style={`mask: ${mask}; -webkit-mask: ${mask};`}></span>
  </a>
  <div class="flex items-center gap-2">
    <a href="/blog">blog</a>
    <a href="https://parsam.substack.com/subscribe">subscribe</a>
  </div>
</nav>
