---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import Layout from "./Layout.astro";
import Prose from "./Prose.astro";
import TableOfContents from "./TableOfContents.astro";
import NewsletterForm from "./NewsletterForm.astro";
import { getBlogPosts, getPostDescription } from "../data/utils";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const posts = await getBlogPosts();
const index = posts.findIndex((p) => p.id === post.id);
const newer = index > 0 ? posts[index - 1] : undefined;
const older = index < posts.length - 1 ? posts[index + 1] : undefined;

const ogImage = new URL(
  `${Astro.url.pathname.replace(/\/+$/, "")}/og.png`,
  Astro.site,
);
---

<Layout
  title={post.data.title}
  image={ogImage}
  description={getPostDescription(post)}
  date={post.data.date}
  post
>
  <section>
    <div class="mb-6">
      <h1 id="top" class="mb-2 text-3xl font-bold sm:text-4xl">
        {post.data.title}
        <span class="font-medium">
          {post.data.author ? ` (${post.data.author})` : ""}
        </span>
      </h1>
      <div class="flex items-center gap-3 text-sm">
        <span class="flex-1">
          {
            post.data.date.toLocaleDateString("en-GB", {
              day: "numeric",
              month: "long",
              year: "numeric",
            })
          }
        </span>
      </div>
    </div>
    <div class="relative">
      <TableOfContents title={post.data.title} headings={headings} />
      <article>
        <Prose
          class="prose-headings:mt-7 prose-headings:mb-3 prose-h1:text-3xl prose-h2:text-2xl prose-h3:text-xl"
          ><Content /></Prose
        >
      </article>
    </div>
    <Prose class="prose-h3:text-xl mt-6 pt-8 border-t">
      <h3>Enjoyed this post?</h3>
      <NewsletterForm />
      <p>And consider...</p>
      <ul>
        <li>
          following me on{" "}
          <a href="https://x.com/pzrsaa">Twitter/X</a>
        </li>
        <li>sharing this post with a friend</li>
        <li>
          sharing your thoughts over{" "}
          <a href="mailto:hi@parsam.io">email</a>
        </li>
      </ul>
    </Prose>

    <nav
      aria-label="More posts"
      class="mt-8 grid grid-cols-3 items-center border-t-2 border-foreground pt-2 text-sm"
    >
      {
        older ? (
          <a
            href={`/${older.id}`}
            title={older.data.title}
            class="py-2 text-left font-normal"
          >
            prev
          </a>
        ) : (
          <span />
        )
      }
      <a href="#top" title="Go to top" class="py-2 text-center font-normal">
        back to top
      </a>
      {
        newer ? (
          <a
            href={`/${newer.id}`}
            title={newer.data.title}
            class="py-2 text-right font-normal"
          >
            next
          </a>
        ) : (
          <span />
        )
      }
    </nav>
  </section>
</Layout>

<script>
  const videos = document.querySelectorAll<HTMLVideoElement>(
    "video[data-scroll-play]",
  );

  if (
    videos.length &&
    !window.matchMedia("(prefers-reduced-motion: reduce)").matches
  ) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const video = entry.target as HTMLVideoElement;
          if (entry.intersectionRatio >= 0.35) {
            void video.play().catch(() => {});
          } else {
            video.pause();
          }
        }
      },
      { threshold: 0.35 },
    );

    videos.forEach((video) => observer.observe(video));
  }
</script>
