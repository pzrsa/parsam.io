---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import Layout from "./Layout.astro";
import Prose from "./Prose.astro";
import TableOfContents from "./TableOfContents.astro";
import NewsletterForm from "./NewsletterForm.astro";
import { getBlogPosts, getPostDescription } from "../data/utils";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const posts = await getBlogPosts();
const index = posts.findIndex((p) => p.id === post.id);
const newer = index > 0 ? posts[index - 1] : undefined;
const older = index < posts.length - 1 ? posts[index + 1] : undefined;

const ogImage = new URL(
  `${Astro.url.pathname.replace(/\/+$/, "")}/og.png`,
  Astro.site,
);
---

<Layout
  title={post.data.title}
  image={ogImage}
  description={getPostDescription(post)}
  date={post.data.date}
  post
>
  <section>
    <div class="mb-6">
      <h1 id="top" class="mb-2 text-3xl font-bold sm:text-4xl">
        {post.data.title}
        <span class="font-medium">
          {post.data.author ? ` (${post.data.author})` : ""}
        </span>
      </h1>
      <div class="text-sm text-muted">
        <time
          datetime={post.data.date.toISOString().slice(0, 10)}
          class="mr-4 inline-block"
        >
          {post.data.date.toLocaleDateString("en-GB", {
            day: "numeric",
            month: "long",
            year: "numeric",
          })}
        </time>
        <TableOfContents title={post.data.title} headings={headings} />
      </div>
    </div>
    <div>
      <article>
        <Prose class="prose-headings:mt-7 prose-headings:mb-3 prose-h1:text-3xl prose-h2:text-2xl prose-h3:text-xl">
          <Content />
        </Prose>
      </article>
    </div>
    <footer class="mt-10 border-t border-rule pt-5">
      <Prose class="prose-h3:mt-0 prose-h3:text-lg">
        <h3>Enjoyed this post?</h3>
        <p>
          I'm planning to write more posts like this. Get the next one by email.
        </p>
        <NewsletterForm />
        <p>And consider...</p>
        <ul>
          <li>
            following me on <a href="https://x.com/pzrsaa">twitter/x</a>
          </li>
          <li>sharing this post with a friend</li>
          <li>
            sharing your thoughts over <a href="mailto:hi@parsam.io">email</a>
          </li>
        </ul>
      </Prose>
    </footer>

    <nav
      aria-label="More posts"
      class="mt-6 grid grid-cols-3 items-center text-sm"
    >
      {older ? (
        <a
          href={`/${older.id}`}
          title={older.data.title}
          class="w-fit justify-self-start py-2 font-normal"
        >
          prev
        </a>
      ) : (
        <span />
      )}
      <a
        href="#top"
        title="Go to top"
        class="w-fit justify-self-center py-2 font-normal"
      >
        back to top
      </a>
      {newer ? (
        <a
          href={`/${newer.id}`}
          title={newer.data.title}
          class="w-fit justify-self-end py-2 font-normal"
        >
          next
        </a>
      ) : (
        <span />
      )}
    </nav>
  </section>
</Layout>

<script>
  const videos = document.querySelectorAll<HTMLVideoElement>(
    "video[data-scroll-play]",
  );

  if (
    videos.length &&
    !window.matchMedia("(prefers-reduced-motion: reduce)").matches
  ) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const video = entry.target as HTMLVideoElement;
          if (entry.intersectionRatio >= 0.35) {
            void video.play().catch(() => {});
          } else {
            video.pause();
          }
        }
      },
      { threshold: 0.35 },
    );

    videos.forEach((video) => observer.observe(video));
  }
</script>
